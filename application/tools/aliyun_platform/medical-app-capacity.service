[Unit]
Description=Medical platform capacity, backup freshness and private certificate warning
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/medical-app/source
Environment=PYTHONPATH=/opt/medical-app/source
ExecStart=/usr/bin/python3 -m tools.aliyun_platform.maintenance capacity
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
