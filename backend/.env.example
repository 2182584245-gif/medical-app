# Set these in an operator-only local env file or secret manager.
PLATFORM_ENV=production
PLATFORM_REQUIRE_HTTPS=true
PLATFORM_ALLOWED_HOSTS=[]
PLATFORM_DATABASE_URL=
PLATFORM_TOKEN_PEPPER=
PLATFORM_LIBRARY_ROOT=/app/library
HEALTHLIFE_AI_SECRET_ENVELOPE=/run/fawnsee/ai/deepseek-envelope
HEALTHLIFE_AI_SECRET_KEY_FILE=/run/fawnsee/ai/ai-key
HEALTHLIFE_DEVELOPER_KEY_FILE=/run/fawnsee/ai/developer-key
QWEN_VL_BASE_URL=
QWEN_VL_API_KEY_FILE=/run/fawnsee/ai/qwen-vl-key
QWEN_ASR_ENDPOINT=
